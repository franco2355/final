<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vision_safety</name>
  <version>0.2.0</version>
  <description>
    Passive vision + LiDAR fusion layer for the autonomous navigation stack.
    Phase 1: read detections and LiDAR, fuse, publish markers and fusion status.
    No cmd_vel gate is active in passive mode — the simulation base is untouched.
  </description>
  <maintainer email="dev@example.com">franco</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pointcloud_to_laserscan</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
